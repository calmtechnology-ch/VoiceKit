{
  "name": "VoiceKit",
  "version": "0.2.1",
  "description": "Bibliothèque C++/Arduino de synthèse vocale TTS asynchrone pour M5Stack CoreS3 via Gemini Live (moteur VoxCore)",
  "keywords": [
    "voicekit",
    "voxcore",
    "tts",
    "voice",
    "gemini",
    "gemini-live",
    "m5stack",
    "cores3",
    "audio"
  ],
  "authors": [
    {
      "name": "Philippe AD / VoxCore Project",
      "url": "https://github.com/Philippe-AD/VoiceKit",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Philippe-AD/VoiceKit.git"
  },
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": "VoxCoreVoice.h",
  "dependencies": {
    "m5stack/M5CoreS3": "1.0.0",
    "m5stack/M5Unified": "0.2.23"
  },
  "build": {
    "flags": [
      "-std=gnu++17",
      "-DVOXCORE_AUDIO_MODE=2",
      "-Isrc"
    ]
  }
}
