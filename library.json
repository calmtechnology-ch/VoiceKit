{
  "name": "VoiceKit",
  "version": "0.6.7.2",
  "description": "Bibliotheque C++17/Arduino multi-fournisseurs (Google Gemini Live & OpenAI Realtime) pour M5Stack CoreS3 : synthese vocale (TTS 24 kHz), reconnaissance vocale (STT), conversation bidirectionnelle temps reel, interaction vocale 2 clics (PTT & VAD), profils vocaux multilingues NVS, commandes locales securisees (ToolRegistry) et detection locale de mot de reveil (WakeNet) — v0.6.7.2",
  "keywords": [
    "voicekit",
    "voxcore",
    "voice-ux",
    "voice-ux-live-bridge",
    "voice-bridge",
    "textgate",
    "intent-router",
    "reply-memory",
    "tools",
    "tool-registry",
    "tts",
    "stt",
    "wakeword",
    "wakenet",
    "esp-sr",
    "conversation",
    "speech-to-text",
    "voice",
    "gemini",
    "gemini-live",
    "openai",
    "openai-realtime",
    "m5stack",
    "cores3",
    "audio"
  ],
  "authors": [
    {
      "name": "Philippe AD / VoxCore Project",
      "url": "https://github.com/calmtechnology-ch/VoiceKit",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/calmtechnology-ch/VoiceKit.git"
  },
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": [
    "VoiceKit.h",
    "VoxCoreVoice.h",
    "VoiceProfileManager.h",
    "IntegratedVoicePipeline.h",
    "WakeWordConversationController.h",
    "ToolRegistry.h",
    "VoiceUxController.h",
    "VoiceUxLiveBridge.h",
    "VoiceInteractionController.h",
    "VoiceCaptureValidator.h"
  ],
  "dependencies": {
    "m5stack/M5CoreS3": "1.0.0",
    "m5stack/M5Unified": "0.2.23"
  },
  "build": {
    "extraScript": "extra_script.py",
    "srcFilter": [
      "+<*>",
      "+<core/*>",
      "+<core/interaction/*>",
      "+<core/pipeline/*>",
      "+<core/tools/*>",
      "+<core/voiceux/*>",
      "+<hal/*>",
      "+<esp_sr/*>"
    ],
    "flags": [
      "-std=gnu++17",
      "-DVOXCORE_AUDIO_MODE=2",
      "-Isrc",
      "-Isrc/esp_sr/include"
    ]
  }
}
