{
  "name": "VoiceKit",
  "version": "0.5.0",
  "description": "Bibliothèque C++/Arduino de synthèse vocale (TTS), reconnaissance vocale (STT), dictée continue mains libres (ContinuousSTT), conversation bidirectionnelle, façade simplifiée VoiceKit, configuration vocale et support UTF-8 pour M5Stack CoreS3 via Gemini Live (moteur VoxCore) — v0.5.0",
  "keywords": [
    "voicekit",
    "voxcore",
    "tts",
    "stt",
    "conversation",
    "speech-to-text",

    "voice",
    "gemini",
    "gemini-live",
    "m5stack",
    "cores3",
    "audio"
  ],
  "authors": [
    {
      "name": "Philippe AD / VoxCore Project",
      "url": "https://github.com/Philippe-AD/VoiceKit",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Philippe-AD/VoiceKit.git"
  },
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "headers": [
    "VoiceKit.h",
    "VoxCoreVoice.h"
  ],
  "dependencies": {
    "m5stack/M5CoreS3": "1.0.0",
    "m5stack/M5Unified": "0.2.23"
  },
  "build": {
    "flags": [
      "-std=gnu++17",
      "-DVOXCORE_AUDIO_MODE=2",
      "-Isrc"
    ]
  }
}
